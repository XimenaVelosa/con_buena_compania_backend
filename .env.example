# Connection strings from Neon. Keep real values only in .env.
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/neondb?sslmode=require"

# Only needed if Neon Auth is enabled.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# CRM authentication uses its own administrator and session tables in Postgres.
# The deployed frontend proxies /api to this backend so cookies remain same-origin.
CRM_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://con-buena-compania.vercel.app
# Optional for the one-time admin:create script. Do not put credentials in Git.
# CRM_ADMIN_USERNAME=admin
# CRM_ADMIN_PASSWORD=

// use prisma-8

model Client {
  id                    Uuid    @id @default(uuid())

  // Datos de la visita inicial
  visitDate             String?
  visitTime             String?
  visitLocation         String?
  visitAgentName        String?

  // Información básica de la persona usuaria
  fullName              String
  approximateAge        Int?
  phone                 String?
  address               String?

  // Personas relacionadas con la solicitud y el pago
  requesterName         String?
  requesterRelationship String?
  payerName             String?
  knowsVisit            Boolean @default(false)

  // Levantamiento de necesidades y condiciones de acompañamiento
  mobilityNeeds         String?
  mobilityNotes         String?
  independentActivities String?
  independenceNotes     String?
  homeAccessConditions  String?
  homeSafetyNotes       String?
  medicationSupport     String?
  personalCareSupport   String?
  outingConditions      String?
  transportPlan         String?
  homeSafetyConditions  String?
  emergencyContacts     String?
  preferences           String?
  visitConclusion       String?
  recommendedServices   String?
  nextContact           String?
  finalNotes            String?

  createdAt      temporal.createdAt()
  updatedAt      temporal.updatedAt()
}

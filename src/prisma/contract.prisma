// use prisma-8

model AdminUser {
  id                  Uuid    @id @default(uuid())
  username            String  @unique
  displayName         String
  passwordHash        String
  role                String  @default("admin")
  mustChangePassword  Boolean @default(true)
  failedLoginAttempts Int     @default(0)
  lockedUntil         String?
  createdAt           temporal.createdAt()
}

model AdminSession {
  id        Uuid   @id @default(uuid())
  tokenHash String @unique
  userId    Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt String

  @@index([userId])
}

model Client {
  id                    Uuid    @id @default(uuid())

  // Datos de la visita inicial
  visitDate             String?
  visitTime             String?
  visitLocation         String?
  visitLatitude         Float?
  visitLongitude        Float?
  visitAgentName        String?

  // Información básica de la persona usuaria
  fullName              String
  approximateAge        Int?
  phone                 String?
  address               String?

  // Personas relacionadas con la solicitud y el acudiente
  requesterName         String?
  requesterRelationship String?
  payerName             String? // Nombre del acudiente; se conserva la clave histórica.
  guardianIdNumber      String?
  guardianAddress       String?
  guardianPhone         String?
  knowsVisit            Boolean @default(false)
  // Evidencia de autorización: texto, versión, decisiones, fecha y operador.
  dataAuthorization     String?

  // Levantamiento de necesidades y condiciones de acompañamiento
  mobilityNeeds         String?
  mobilityNotes         String?
  independentActivities String?
  independenceNotes     String?
  homeAccessConditions  String?
  homeSafetyNotes       String?
  medicationSupport     String?
  personalCareSupport   String?
  outingConditions      String?
  transportPlan         String?
  homeSafetyConditions  String?
  emergencyContacts     String?
  preferences           String?
  visitConclusion       String?
  recommendedServices   String?
  nextContact           String?
  finalNotes            String?

  createdAt      temporal.createdAt()
  updatedAt      temporal.updatedAt()
}
